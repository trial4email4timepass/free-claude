+    def _resolve_fallback_chain(self, app_config: AppConfig, model_name: str | None) -> list[str]:
+        """Ordered, de-duplicated list of fallback model names for ``model_name``.
+
+        Drops a name that doesn't resolve to a configured model, that repeats
+        an earlier entry, or that points back to ``model_name`` itself (which
+        would otherwise let a misconfigured chain loop forever) - each with a
+        warning, since a broken fallback entry should degrade rather than break
+        agent startup.
+        """
+        if not model_name:
+            return []
+        model_config = app_config.get_model_config(model_name)
+        if model_config is None or not model_config.fallback_models:
+            return []
+        seen = {model_name}
+        chain: list[str] = []
+        for candidate in model_config.fallback_models:
+            if candidate in seen:
+                logger.warning(
+                    "Model '%s' fallback_models: skipping duplicate or self-referential entry '%s'.",
+                    model_name,
+                    candidate,
+                )
+                continue
+            seen.add(candidate)
+            if app_config.get_model_config(candidate) is None:
+                logger.warning(
+                    "Model '%s' fallback_models: '%s' is not a configured model; skipping.",
+                    model_name,
+                    candidate,
+                )
+                continue
+            chain.append(candidate)
+        return chain
+
+    def _get_or_build_fallback_model(self, name: str) -> BaseChatModel:
+        """Build (and cache) the fallback chat model instance for ``name``.
+
+        Cached per middleware instance - a fresh middleware is built per agent
+        graph assembly (see ``build_lead_runtime_middlewares`` /
+        ``build_subagent_runtime_middlewares``), so this never outlives one run.
+        ``attach_tracing=False`` matches every other in-graph
+        ``create_chat_model`` call: tracing is attached once at the graph root
+        (see the module docstring on ``lead_agent/agent.py``).
+        """
+        model_instance = self._fallback_model_cache.get(name)
+        if model_instance is None:
+            from deerflow.models.factory import create_chat_model
+
+            model_instance = create_chat_model(name, app_config=self._app_config, attach_tracing=False)
+            self._fallback_model_cache[name] = model_instance
+        return model_instance
+
+    def _iter_call_candidates(self, request: ModelRequest) -> Iterator[tuple[str | None, ModelRequest]]:
+        """Yield ``(label, request)`` for the primary model, then each fallback in order.
+
+        The primary is always ``request`` unchanged. A fallback candidate whose
+        model instance fails to build (bad class path, missing credentials key,
+        etc.) is logged and skipped rather than aborting the whole chain - the
+        remaining fallbacks (and the user-facing failure message) still apply.
+        """
+        yield self._model_name, request
+        for name in self._fallback_chain:
+            try:
+                fallback_model = self._get_or_build_fallback_model(name)
+            except Exception:
+                logger.exception("Failed to build fallback model '%s'; skipping.", name)
+                continue
+            yield name, request.override(model=fallback_model)
+
