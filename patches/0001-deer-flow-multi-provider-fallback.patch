+def test_fallback_chain_exhausted_returns_final_provider_message(monkeypatch: pytest.MonkeyPatch) -> None:
+    """When every model in the chain fails, the message reflects the last failure."""
+    monkeypatch.setattr("time.sleep", lambda _d: None)
+    middleware = _build_middleware_with_fallback(
+        fallback_models=["backup"],
+        other_models=["backup"],
+        retry_max_attempts=1,
+    )
+    monkeypatch.setattr(
+        "deerflow.models.factory.create_chat_model",
+        lambda name, *, app_config, attach_tracing: _FakeChatModel(name),
+    )
+
+    request = _FakeModelRequest(_FakeChatModel("primary"))
+
+    def handler(req: _FakeModelRequest) -> AIMessage:
+        raise FakeError(f"{req.model.label} is down", status_code=503)
+
+    result = middleware.wrap_model_call(request, handler)
+    assert result.additional_kwargs.get("error_reason") == "transient"
+    assert "primary is down" not in result.content  # generic user-facing copy, not the raw detail
+    # Both the primary and the one configured fallback were attempted.
+    assert middleware._circuit_failure_count == 1
