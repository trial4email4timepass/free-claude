+    def _run_attempts_sync(
+        self,
+        request: ModelRequest,
+        handler: Callable[[ModelRequest], ModelResponse],
+    ) -> ModelResponse:
+        """Retry/backoff loop for one candidate model. Raises ``_RetryExhausted`` on final failure."""
+        attempt = 1
+        prev_delay_ms: int | None = None
+        while True:
+            try:
+                return self._bounded_model_call_sync(request, handler)
+            except GraphBubbleUp:
