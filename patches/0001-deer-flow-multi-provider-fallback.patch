+
+
+# ---------- Cross-provider fallback (ModelConfig.fallback_models) ----------
+
+
+class _FakeChatModel:
+    """Stand-in for a real provider's BaseChatModel, identified by `label`."""
+
+    def __init__(self, label: str) -> None:
+        self.label = label
+
+    def __repr__(self) -> str:
+        return f"_FakeChatModel({self.label!r})"
+
+
+class _FakeModelRequest:
+    """Minimal stand-in for langchain's ModelRequest: carries `.model` and supports `.override(model=...)`."""
+
+    def __init__(self, model: _FakeChatModel) -> None:
+        self.model = model
+
+    def override(self, **overrides: object) -> _FakeModelRequest:
+        return _FakeModelRequest(overrides.get("model", self.model))
+
+
+def _make_model_config(name: str, *, fallback_models: list[str] | None = None) -> ModelConfig:
+    return ModelConfig(name=name, use="langchain_openai:ChatOpenAI", model=name, fallback_models=fallback_models)
+
+
+def _build_middleware_with_fallback(
+    *,
+    primary: str = "primary",
+    fallback_models: list[str] | None = None,
+    other_models: list[str] = (),
+    **attrs: int,
+) -> LLMErrorHandlingMiddleware:
+    llm_call_fields = {_LLM_CALL_ATTR_MAP[key]: value for key, value in attrs.items() if key in _LLM_CALL_ATTR_MAP}
+    models = [_make_model_config(primary, fallback_models=fallback_models)]
+    models.extend(_make_model_config(name) for name in other_models)
+    app_config = AppConfig(
+        sandbox=SandboxConfig(use="test"),
+        llm_call=LlmCallConfig(**llm_call_fields),
+        models=models,
+    )
+    middleware = LLMErrorHandlingMiddleware(app_config=app_config, model_name=primary)
+    for key, value in attrs.items():
+        if key not in _LLM_CALL_ATTR_MAP:
+            setattr(middleware, key, value)
+    return middleware
+
+
+def test_fallback_chain_drops_unresolvable_self_referential_and_duplicate_entries(
+    caplog: pytest.LogCaptureFixture,
+) -> None:
+    """Only names that resolve to a *different* configured model survive."""
+    middleware = _build_middleware_with_fallback(
+        fallback_models=["primary", "backup", "backup", "ghost"],
+        other_models=["backup"],
+    )
+    assert middleware._fallback_chain == ["backup"]
+
+
+def test_no_fallback_configured_behaves_exactly_as_before(monkeypatch: pytest.MonkeyPatch) -> None:
+    """A model with no `fallback_models` never calls `.override` on the request."""
+    middleware = _build_middleware_with_fallback(fallback_models=None)
+    assert middleware._fallback_chain == []
+
+    request = SimpleNamespace()  # no .override attribute at all
+    result = middleware.wrap_model_call(request, transient_failing_handler)
+    assert result.additional_kwargs.get("error_reason") == "transient"
+
+
+def test_fallback_model_used_after_primary_exhausts_retries(monkeypatch: pytest.MonkeyPatch) -> None:
+    """Primary keeps failing (transient) -> its retry budget exhausts -> the
+    configured fallback model is tried next and succeeds."""
+    monkeypatch.setattr("time.sleep", lambda _d: None)
+    middleware = _build_middleware_with_fallback(
+        fallback_models=["backup"],
+        other_models=["backup"],
+        retry_max_attempts=2,
+    )
+
+    fake_backup_model = _FakeChatModel("backup")
+    built_names: list[str] = []
+
+    def fake_create_chat_model(name: str, *, app_config, attach_tracing):
+        built_names.append(name)
+        assert attach_tracing is False
+        return fake_backup_model
+
+    monkeypatch.setattr("deerflow.models.factory.create_chat_model", fake_create_chat_model)
+
+    request = _FakeModelRequest(_FakeChatModel("primary"))
+
+    def handler(req: _FakeModelRequest) -> AIMessage:
+        if req.model.label == "primary":
+            raise FakeError("Server Error", status_code=502)
+        return AIMessage(content=f"handled by {req.model.label}")
+
+    result = middleware.wrap_model_call(request, handler)
+    assert result.content == "handled by backup"
+    assert built_names == ["backup"]
+    # A successful fallback call counts as an overall success for the circuit breaker.
+    assert middleware._circuit_failure_count == 0
+
+
+@pytest.mark.anyio
+async def test_async_fallback_model_used_after_primary_exhausts_retries(monkeypatch: pytest.MonkeyPatch) -> None:
