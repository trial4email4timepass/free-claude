+def test_fallback_not_attempted_for_unclassified_generic_errors(monkeypatch: pytest.MonkeyPatch) -> None:
+    """An unclassified ('generic') error does not trigger a provider swap."""
+    middleware = _build_middleware_with_fallback(fallback_models=["backup"], other_models=["backup"])
+    build_calls: list[str] = []
+    monkeypatch.setattr(
+        "deerflow.models.factory.create_chat_model",
+        lambda name, *, app_config, attach_tracing: (build_calls.append(name), _FakeChatModel(name))[1],
+    )
+
+    request = _FakeModelRequest(_FakeChatModel("primary"))
+
+    def handler(req: _FakeModelRequest) -> AIMessage:
+        raise ValueError("totally unexpected bug")
+
+    result = middleware.wrap_model_call(request, handler)
+    assert result.additional_kwargs.get("error_reason") == "generic"
+    assert build_calls == []  # fallback model was never even built
