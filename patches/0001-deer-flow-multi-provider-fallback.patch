+def test_fallback_tried_on_quota_error() -> None:
+    """A quota/billing failure on the primary is exactly the case fallback exists for."""
+    middleware = _build_middleware_with_fallback(fallback_models=["backup"], other_models=["backup"])
+
+    fake_backup_model = _FakeChatModel("backup")
+    import deerflow.models.factory as factory_module
+
+    original = factory_module.create_chat_model
+    factory_module.create_chat_model = lambda name, *, app_config, attach_tracing: fake_backup_model
+    try:
+        request = _FakeModelRequest(_FakeChatModel("primary"))
+
+        def handler(req: _FakeModelRequest) -> AIMessage:
+            if req.model.label == "primary":
+                raise FakeError("Quota exceeded", body={"error": {"code": "insufficient_quota"}})
+            return AIMessage(content="handled by backup")
+
+        result = middleware.wrap_model_call(request, handler)
+        assert result.content == "handled by backup"
+    finally:
+        factory_module.create_chat_model = original
+
