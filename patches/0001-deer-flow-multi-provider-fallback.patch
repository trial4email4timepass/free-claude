+class _RetryExhausted(Exception):
+    """Internal signal: one model's retry budget under this middleware ran out.
+
+    Raised by ``_run_attempts_sync``/``_run_attempts_async`` instead of directly
+    building the user-facing fallback message, so the caller can decide whether
+    to try the next model in the fallback chain before giving up.
+    """
+
+    def __init__(self, exc: BaseException, reason: str) -> None:
+        super().__init__(str(exc))
+        self.exc = exc
+        self.reason = reason
